{
  "name": "medextract",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Extract structured medical data from clinical notes with a small local model, against contract packs you own — with the gate that says whether it is good enough attached.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "medextract": "./src/cli.ts",
    "medextract-server": "./src/server.ts",
    "medextract-tui": "./src/tui.ts"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.vendor.json",
    "check": "npm test && npm run typecheck",
    "profiles": "node src/cli.ts profiles",
    "eval": "node src/cli.ts eval",
    "agent": "node src/cli.ts agent",
    "route": "node src/cli.ts route",
    "pipeline": "node src/cli.ts pipeline",
    "server": "node src/server.ts",
    "tui": "node --experimental-ffi src/tui.ts",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:typecheck": "npm --prefix web run typecheck",
    "model-manager": "node scripts/model-manager.ts"
  },
  "dependencies": {
    "smol-toml": "^1.3.1",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@opentui/core": "^0.5.10"
  }
}
